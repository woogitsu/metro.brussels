<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Konsolowy gospodarz rdzenia. Istnieje po jedno: policzyć ten sam przejazd, co
    scena Godota, **bez Godota**, i dać się porównać liczba po liczbie.

    Nie jest częścią rdzenia (src/Sim) ani warstwy silnika (src/Game): jest narzędziem
    weryfikacji. Zero PackageReference — tak samo jak rdzeń.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MetroBxl.Sim.Runner</RootNamespace>
    <AssemblyName>MetroBxl.Sim.Runner</AssemblyName>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>

    <!--
      Ta sama bramka co w rdzeniu i z tego samego powodu — patrz komentarz przy
      `GenerateDocumentationFile` w `src/Sim/Sim.csproj`. Zmierzone 04.09.2026 na
      `74d323c`: w tym projekcie ZERO ostrzeżeń przy włączeniu; przełącznik jest tu
      po to, żeby następny plik runnera nie wjechał bez opisu, a nie żeby coś naprawić.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

</Project>
