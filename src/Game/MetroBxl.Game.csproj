<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!--
    Warstwa silnika. CLAUDE.md reguła 9 działa w drugą stronę niż w rdzeniu: tutaj
    Godot wolno, ale logiki symulacji nie. Jedyna zależność poza silnikiem to rdzeń.

    Projekt NIE jest w MetroBxl.sln i to jest decyzja, nie przeoczenie: `dotnet build
    MetroBxl.sln` z CI rdzenia musiałby wtedy ściągać Godot.NET.Sdk, żeby zbudować
    rzecz, której rdzeń nie dotyczy. Rdzeń ma się budować bez silnika — także w CI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MetroBxl.Game</RootNamespace>
    <AssemblyName>MetroBxl.Game</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Dokumentacji XML pilnuje kompilator — powód i pomiar przy tym samym przełączniku
      w `src/Sim/Sim.csproj`. Zmierzone 04.09.2026 na `74d323c`: w tej warstwie
      2 ostrzeżenia (2x CS1570 w `FirstRun.cs`), obydwa naprawione w tym samym commicie.

      `WarningsAsErrors` zamiast `TreatWarningsAsErrors`, i to jest różnica wobec
      rdzenia: ten projekt buduje się przez Godot.NET.Sdk, który dokłada własne źródła
      generowane, a rdzeń ma się kompilować bez silnika. Podniesienie WSZYSTKICH
      ostrzeżeń do błędów wiązałoby zielony build z tym, co dołoży kolejna wersja SDK;
      wymieniona szóstka to wyłącznie rodzina dokumentacji XML, czyli dokładnie to,
      co ta bramka ma bramkować.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

</Project>
