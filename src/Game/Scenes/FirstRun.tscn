[gd_scene load_steps=8 format=3]

; Struktura sceny pierwszego przejazdu. Celowo płaska i celowo pusta z danych:
; geometria tunelu i składu jest wczytywana z build/ w czasie działania (patrz
; GlbLoader), a nie zapisana tutaj — CLAUDE.md reguła 8 nie dopuszcza wygenerowanych
; siatek w repozytorium. To, co widać w tym pliku, to wyłącznie węzły i ich role.

[ext_resource type="Script" path="res://FirstRun.cs" id="1_root"]
[ext_resource type="Script" path="res://World/TunnelView.cs" id="2_tunnel"]
[ext_resource type="Script" path="res://World/TrainView.cs" id="3_train"]
[ext_resource type="Script" path="res://World/StationView.cs" id="5_station"]
[ext_resource type="Script" path="res://World/CabView.cs" id="6_cab"]
[ext_resource type="Script" path="res://UI/Hud.cs" id="4_hud"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hud"]
bg_color = Color(0.03, 0.03, 0.04, 0.62)
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0

[node name="FirstRun" type="Node3D"]
script = ExtResource("1_root")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]

[node name="Tunnel" type="Node3D" parent="."]
script = ExtResource("2_tunnel")

[node name="Platforms" type="Node3D" parent="."]
script = ExtResource("5_station")

[node name="Train" type="Node3D" parent="."]
script = ExtResource("3_train")

; Kabina stoi OBOK składu, a nie pod nim, i to jest treść, a nie porządek (MB-05).
; Widoczność w Godocie dziedziczy się po rodzicu: węzeł pod `Train` gasłby razem
; z nim, gdy `ApplyView` chowa skorupę w widoku kabinowym — czyli dokładnie wtedy,
; kiedy ma być widoczny. Pole „Skończone, gdy" pozycji MB-05 żąda wprost, żeby
; wnętrze „nie znikało razem ze skorupą ukrywaną w trybie kabinowym".
[node name="Cab" type="Node3D" parent="."]
script = ExtResource("6_cab")

[node name="CabCamera" type="Camera3D" parent="."]
current = true
fov = 70.0
near = 0.1
far = 900.0

[node name="Headlight" type="OmniLight3D" parent="CabCamera"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.6, -1.5)
light_energy = 2.5
omni_range = 70.0

[node name="ChaseCamera" type="Camera3D" parent="."]
current = false
fov = 60.0
near = 0.1
far = 900.0

[node name="ChaseLight" type="OmniLight3D" parent="ChaseCamera"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
light_energy = 2.0
omni_range = 80.0

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("4_hud")

; PANEL JEST ZAKOTWICZONY PO OBU STRONACH — 6.D82.
;
; Do 10.09.2026 stała tu kotwica `anchors_preset = 2` (lewy dolny róg) i
; `offset_right = 900.0`, czyli szerokość STAŁA 876 px niezależnie od widoku.
; Przy 1280 x 720 panel kończył się na x = 900 i miał widoczną prawą krawędź;
; przy 800 x 600 sięgał poza brzeg okna. Zmierzone zrzutami z silnika przy
; kilometrażu 2054 m, czyli przy `Comte de Flandre|Graaf van Vlaanderen` —
; NAJDŁUŻSZEJ nazwie stacji w danych osi (37 znaków):
;
;   1280 x 720   „… Comte de Flandre|Graaf van Vlaanderen za 1 m"   (całe)
;    800 x 600   „… Comte de Flandre|Graaf van Vlaanderen za 1"     (UCIĘTE)
;
; Ucięta jest JEDNOSTKA, a przy dłuższej odległości ucięte byłyby cyfry — czyli
; gracz przy węższym widoku nie odczyta, ile zostało do peronu. To utrata
; informacji sterującej, nie wygląd (`CLAUDE.md` §8 wyklucza z kolejki wyłącznie
; oceny estetyczne). Kolory i układ wierszy zostają nietknięte.
;
; `anchors_preset = 12` to dolna krawędź na całą szerokość; szerokość liczy się
; dziś z widoku minus 24 px z każdej strony, więc odstęp od brzegu jest ten sam
; po obu stronach i przy każdej rozdzielczości.
[node name="Panel" type="PanelContainer" parent="Hud"]
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -92.0
offset_right = -24.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_hud")

[node name="Rows" type="VBoxContainer" parent="Hud/Panel"]
theme_override_constants/separation = 1

[node name="Speed" type="Label" parent="Hud/Panel/Rows"]
text = "0.0 km/h"

; Wiersz blokady trakcji — MB-03. Stoi DRUGI, zaraz pod prędkością, bo to on mówi
; graczowi, dlaczego pociąg nie rusza; startuje UKRYTY, a jego treść przychodzi
; z `TractionBlock.Line`, czyli z odczytu dwóch filtrów rdzenia.
[node name="Traction" type="Label" parent="Hud/Panel/Rows"]
autowrap_mode = 3
text = "trakcja"

; Wiersz stacji stoi PRZED wierszem pozycji — MB-03. Niesie cel i odległość do punktu
; zatrzymania, czyli NASTĘPNE DZIAŁANIE; wiersz pozycji niesie kilometraż osi, czyli
; współrzędną dewelopera. Zawija z tego samego powodu, co wiersz pozycji: nazwa
; dwujęzyczna nie ma spacji przy pionowej kresce.
[node name="Station" type="Label" parent="Hud/Panel/Rows"]
autowrap_mode = 3
text = "stacja"

; Wiersz pozycji ZAWIJA — 6.D82. To on niesie nazwę stacji i odległość do peronu,
; więc to on jako pierwszy przekracza szerokość panelu. `autowrap_mode = 3` to
; zawijanie po słowach z podziałem długiego słowa w ostatniej chwili: nazwa
; dwujęzyczna `Comte de Flandre|Graaf van Vlaanderen` nie ma spacji przy pionowej
; kresce, więc samo zawijanie po słowach (2) zostawiłoby ją nierozdzieloną.
[node name="Position" type="Label" parent="Hud/Panel/Rows"]
autowrap_mode = 3
text = "chainage"

[node name="Controls" type="Label" parent="Hud/Panel/Rows"]
autowrap_mode = 3
text = "ciag / hamulec"

[node name="Signalling" type="Label" parent="Hud/Panel/Rows"]
text = "sygnalizacja"

; Wiersz o widoku. Startuje UKRYTY tak samo jak Station i Signalling, i z tego samego
; powodu: tekst zastępczy jest po to, żeby scena dała się otworzyć w edytorze, a nie
; po to, żeby trafił na pierwszą klatkę zrzutu. Widoczność ustawia dopiero `Hud.Update`.
[node name="View" type="Label" parent="Hud/Panel/Rows"]
text = "widok"

; Wiersz pomocy — opis sterowania. Startuje UKRYTY jak trzy powyższe, a jego treść
; przychodzi z `DriverActions.Help`, czyli z tej samej tabeli, co przypisania `InputMap`
; w project.godot. Tekst zastępczy jest po to, żeby scena dała się otworzyć w edytorze.
[node name="Help" type="Label" parent="Hud/Panel/Rows"]
autowrap_mode = 3
text = "sterowanie"

; Panel wyniku sesji treningowej (MB-02). Startuje UKRYTY jak cztery powyższe.
; ZAWIJA (`autowrap_mode = 3`) z tego samego powodu, co wiersz pozycji: niesie nazwy
; stacji, a te bywają dwujęzyczne i bez spacji przy pionowej kresce. Treść składa
; `RunSummary`, czyli kod bez Godota — tutaj stoi wyłącznie tekst zastępczy, żeby
; scena dała się otworzyć w edytorze.
[node name="Summary" type="Label" parent="Hud/Panel/Rows"]
autowrap_mode = 3
text = "wynik"
