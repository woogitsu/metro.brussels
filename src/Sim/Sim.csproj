<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rdzeń symulacji. CLAUDE.md reguła 9: nic tutaj nie importuje Godota.
    Projekt jest zwykłą biblioteką net10.0 bez ani jednego PackageReference —
    JSON czyta System.Text.Json z shared framework, nie z NuGeta.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MetroBxl.Sim</RootNamespace>
    <AssemblyName>MetroBxl.Sim</AssemblyName>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>

    <!--
      Dokumentacji XML pilnuje kompilator, nie skan tekstowy. Bez tego przełącznika
      Roslyn w ogóle nie parsuje bloków `///`, więc CS1570-CS1574 i CS1591 nie padają
      i `dotnet build` stoi na zerze ostrzeżeń nad opisem, który mówi o nieistniejącym
      parametrze. Zmierzone 04.09.2026 na `74d323c` przy włączeniu: 27 ostrzeżeń
      w tym projekcie (4x CS1572, 8x CS1573, 3x CS1574, 12x CS1591) — wszystkie
      naprawione w tym samym commicie, bo `TreatWarningsAsErrors` powyżej robi z nich
      błędy budowy.

      CS1591 („brak komentarza XML") zostaje WŁĄCZONE i to jest decyzja, nie
      przeoczenie: to właśnie ono łapie blok osierocony. Gdy opis przykleja się do
      sąsiada, kompilator nie widzi drugiego `<summary>` — widzi składnik, któremu opis
      ZABRANO. Tak wyszły trzy z czterech sztuk z #222: `MaxDeviationFromSourceM`,
      `LineCore.Finished` i `LineRun.Run` zgłosiły się jako nieudokumentowane.
      Wyciszenie CS1591 zabrałoby bramce dokładnie tę zdolność.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Ground truth M7 wjeżdża do assembly jako zasób osadzony, a nie jako kopia
      w src/. Dzięki temu istnieje jedna kopia pliku (data/vehicle/m7-spec.json),
      a rdzeń działa w Godocie bez katalogu data/ na dysku.
    -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../data/vehicle/m7-spec.json"
                      LogicalName="MetroBxl.Sim.Data.m7-spec.json" />

    <!--
      Ground truth sygnalizacji (R-003) tą samą drogą i z tego samego powodu:
      T-314 czyta z niego, który tryb ochrony jest historyczny, zamiast kodować
      tę odpowiedź w C#.
    -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../data/signalling/ground-truth.json"
                      LogicalName="MetroBxl.Sim.Data.signalling-ground-truth.json" />
  </ItemGroup>

</Project>
