<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testy rdzenia. Zależności są trzy i wszystkie są Microsoftowe: sam runner
    (Microsoft.NET.Test.Sdk) oraz adapter i framework MSTest. To najmniejszy zestaw,
    przy którym `dotnet test tests/Sim.Tests` z CLAUDE.md §5 w ogóle działa —
    xUnit czy NUnit dokładałyby pakiety spoza platformy bez żadnej korzyści dla
    testów, które sprowadzają się do porównywania liczb. Wersje są dokładnie te,
    które szablon `dotnet new mstest` przypisuje zainstalowanemu SDK 8.0.130.
    Sam projekt src/Sim nie ma ani jednego PackageReference.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MetroBxl.Sim.Tests</RootNamespace>
    <AssemblyName>MetroBxl.Sim.Tests</AssemblyName>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Korzeń repozytorium: JEDEN pomocnik LINKOWANY do obu projektów testowych
    (6.D257). Nie jest to nowa zależność — plik źródłowy wchodzi do każdego
    projektu jako jego własny kod, a trzeci projekt byłby zależnością obu.
  -->
  <ItemGroup>
    <Compile Include="../Shared/KorzenRepozytorium.cs" Link="KorzenRepozytorium.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.0.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.0.4" />
  </ItemGroup>

  <!--
    Drugą referencją jest RUNNER, nie druga część rdzenia. Wchodzi tu razem
    z poleceniem `budget` (pozycja 5.7): pomiar kosztu kroku ma własną klasę
    `LineBudget`, a klasa, której nikt nie testuje, mierzy dokładnie tyle, ile
    twierdzi, że mierzy. Rdzeń `src/Sim` tej referencji nie widzi — zależność
    idzie w jedną stronę, testy → runner → rdzeń.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Sim/Sim.csproj" />
    <ProjectReference Include="../../src/Sim.Runner/Sim.Runner.csproj" />
  </ItemGroup>

</Project>
