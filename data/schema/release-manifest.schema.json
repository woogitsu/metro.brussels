{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metro.brussels/schema/release-manifest.schema.json",
  "title": "Metro BXL playable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "git_commit", "package_system", "godot_preset", "executable", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "git_commit": {"type": "string", "minLength": 1},
    "package_system": {"enum": ["linux", "windows"]},
    "godot_preset": {"enum": ["Linux", "Windows Desktop"]},
    "executable": {"enum": ["MetroBXL.x86_64", "MetroBXL.exe"]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
